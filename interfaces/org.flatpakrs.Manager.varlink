# Experimental: not a stable public API. No sandbox is constructed by this call.
interface org.flatpakrs.Manager

type Check (name: string, available: bool, detail: string)

method GetHostStatus() -> (ready: bool, checks: []Check)
method GetRecoveryStatus() -> (discarded_stages: int)

type Variant (collection: string, id: string, arch: string, branch: string)
type Revision (collection: string, id: string, arch: string, branch: string, commit: string)
method ListInstances() -> (instances: []Variant)
# Streaming Run owns its connection; input/control calls are oneway on that connection.
# An empty command selects Application.command from the installed metadata.
method Run(variant: Variant, command: []string, memory_mib: ?int, pids: ?int, wayland: ?string) -> (kind: string, data: ?string, exit_status: ?int)
method WriteInput(data: string) -> ()
method CloseInput() -> ()
method Cancel() -> ()

method Install(source: string, app: Variant, runtime: Variant, runtime_source: ?string) -> (app: Revision, runtime: Revision, diagnostics: []string)
method Inspect(collection: string, id: string, arch: string, branch: string) -> (app: Revision, runtime: Revision, diagnostics: []string)
method Uninstall(collection: string, id: string, arch: string, branch: string) -> (removed: bool)
method DeleteData(collection: string, id: string, arch: string, branch: string) -> (removed: bool)
method RemoveRuntime(collection: string, id: string, arch: string, branch: string) -> (removed: bool)
method ListRuntimes() -> (runtimes: []Revision)

type Remote (name: string, collection: string, url: string, fingerprints: []string, generation: string, enabled: bool)
method ListRemotes() -> (remotes: []Remote)
method AddRemote(name: string, collection: string, descriptor: string, replace: bool) -> (name: string, collection: string, url: string, fingerprints: []string, generation: string, enabled: bool)
method DisableRemote(name: string) -> (name: string, collection: string, url: string, fingerprints: []string, generation: string, enabled: bool)
type Provider (name: string, generation: string)
type RemoteInstallPlan (format_version: int, app: Revision, runtime: Revision, app_provider: Provider, runtime_provider: Provider)
method PlanInstall(remote: string, id: string, arch: string, branch: string, runtime_remote: string) -> (plan: RemoteInstallPlan)
method ApplyInstall(plan: RemoteInstallPlan) -> (status: string, installed: Installed)
error RemoteOutcomeUncertain(detail: string)

error OperationFailed(detail: string)

type UpdateSelection (app: Revision, runtime: Revision)
type UpdateSources (app: string, runtime: string)
type UpdatePlan (format_version: int, target: Variant, expected: UpdateSelection, desired: UpdateSelection, sources: UpdateSources)
method PlanUpdate(source: string, app: Variant, runtime: Variant, runtime_source: ?string, app_commit: ?string, runtime_commit: ?string) -> (plan: UpdatePlan)
type UpdateInstalled (app: Revision, runtime: Revision, diagnostics: []string)
type UpdateWarning (code: string, detail: string)
method ApplyUpdate(plan: UpdatePlan) -> (outcome: string, selection: UpdateInstalled, warnings: []UpdateWarning)
error UpdateInvalidPlan(detail: string)
error UpdateNotInstalled(target: Variant)
error UpdateBusy(target: Variant)
error UpdateConflict(current: UpdateSelection)
error UpdateSourceInvalid(detail: string)
error UpdateFailed(detail: string)
error UpdateOutcomeUncertain(detail: string)
error UpdateRecoveryRequired(detail: string)
